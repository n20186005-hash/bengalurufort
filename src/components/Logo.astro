---
const { compact = false } = Astro.props;
---
<a href="/" class="focus-ring inline-flex items-center gap-3 rounded-md" aria-label="ಬೆಂಗಳೂರು ಕೋಟೆ ಮಾರ್ಗದರ್ಶಿ ಮುಖಪುಟ">
  <svg viewBox="0 0 64 64" class={compact ? 'h-9 w-9' : 'h-11 w-11'} aria-hidden="true">
    <path d="M9 53V30c0-13 10-23 23-23s23 10 23 23v23H43V32c0-6-5-11-11-11S21 26 21 32v21H9Z" fill="#9c5d36"/>
    <path d="M21 53V32c0-6 5-11 11-11s11 5 11 11v21h-7V35c0-3-2-5-4-5s-4 2-4 5v18h-7Z" fill="#efe3cf"/>
    <path d="M6 53h52v6H6z" fill="#445238"/>
    <circle cx="32" cy="13" r="3" fill="#efe3cf"/>
  </svg>
  {!compact && <span class="leading-tight"><strong class="block text-[1.05rem]">ಬೆಂಗಳೂರು ಕೋಟೆ</strong><span class="block text-xs text-stone-ink/60">ಸ್ವತಂತ್ರ ಪ್ರವಾಸಿ ಮಾರ್ಗದರ್ಶಿ</span></span>}
</a>

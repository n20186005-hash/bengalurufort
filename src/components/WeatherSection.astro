---
// Live weather module for Bengaluru Fort (lat 12.962802, lon 77.5758862).
// The forecast is fetched server-side by the Worker at /api/weather (edge-cached),
// so this component only ever calls the site's own endpoint. The public panel identifies the model provider and timestamp.
interface Props { lang?: 'kn-IN' | 'en-IN'; }
const { lang = 'kn-IN' } = Astro.props;
const en = lang === 'en-IN';
const seasonCards = en
  ? [
      ['Oct–Feb · Comfortable season', 'Cooler mornings and evenings suit outdoor walking. Mornings at the fort are usually calm before the market district gets busy.'],
      ['Mar–May · Warm season', 'Midday heat is strongest. Plan for the first hour of the morning or after about 4pm; carry water, a hat and sun protection.'],
      ['Jun–Sep · Monsoon', 'Bengaluru rains can arrive suddenly. Keep an umbrella or light rainwear, allow extra time for slippery, busy streets, and check the forecast each morning.']
    ]
  : [
      ['ಅಕ್ಟೋಬರ್–ಫೆಬ್ರವರಿ · ಆರಾಮದಾಯಕ ಋತು', 'ತಂಪಾದ ಮುಂಜಾನೆ ಮತ್ತು ಸಂಜೆ ಹೊರಾಂಗಣ ನಡಿಗೆಗೆ ಸೂಕ್ತ. ಮಾರುಕಟ್ಟೆ ಪ್ರದೇಶ ಗದ್ದಲವಾಗುವ ಮೊದಲು ಕೋಟೆಯ ಬೆಳಗಿನ ಹೊತ್ತು ಸಾಮಾನ್ಯವಾಗಿ ಶಾಂತ.'],
      ['ಮಾರ್ಚ್–ಮೇ · ಬೆಚ್ಚನೆ ಋತು', 'ಮಧ್ಯಾಹ್ನದ ಬಿಸಿಲು ಹೆಚ್ಚು. ಮುಂಜಾನೆಯ ಮೊದಲ ಗಂಟೆ ಅಥವಾ ಸಂಜೆ 4ರ ನಂತರ ಯೋಜಿಸಿ; ನೀರು, ಟೋಪಿ ಹಾಗೂ ಸನ್‌ಕವಚ ಒಯ್ಯಿರಿ.'],
      ['ಜೂನ್–ಸೆಪ್ಟೆಂಬರ್ · ಮಳೆಗಾಲ', 'ಬೆಂಗಳೂರಿನಲ್ಲಿ ಮಳೆ ಇದ್ದಕ್ಕಿದ್ದಂತೆ ಬರಬಹುದು. ಛತ್ರಿ ಅಥವಾ ಲಘು ಮಳೆರಕ್ಷೆ ಇಟ್ಟುಕೊಳ್ಳಿ, ಜಾರುವ ಮತ್ತು ಗದ್ದಲದ ರಸ್ತೆಗಳಿಗೆ ಹೆಚ್ಚು ಸಮಯ ಕಾದಿರಿಸಿ, ಪ್ರತಿ ಬೆಳಿಗ್ಗೆ ಮುನ್ನೋಟ ಪರಿಶೀಲಿಸಿ.']
  ];
---
<section id="weather" class="mx-auto max-w-7xl px-5 py-20 lg:px-8 lg:py-28">
  <div class="max-w-3xl">
      <p class="section-kicker">{en ? 'PLAN FOR THE WEATHER' : 'ಹವಾಮಾನಕ್ಕೆ ಅನುಗುಣ ಯೋಜನೆ'}</p>
      <h2 class="section-title">{en ? 'Weather forecast near Bengaluru Fort' : 'ಬೆಂಗಳೂರು ಕೋಟೆ ಬಳಿಯ ಹವಾಮಾನ ಮುನ್ನೋಟ'}</h2>
      <p class="mt-4 leading-8 text-stone-ink/70">
        {en
          ? 'The fort is an open-air site, so the weather shapes your visit. The panel below shows current conditions and a seven-day outlook when this page opens — and turns the forecast into plain advice: do you need an umbrella today?'
          : 'ಕೋಟೆ ಮುಕ್ತ ಹೊರಾಂಗಣ ಸ್ಥಳ ಆಗಿರುವುದರಿಂದ ಹವಾಮಾನ ಭೇಟಿಯನ್ನು ರೂಪಿಸುತ್ತದೆ. ಕೆಳಗಿನ ಪ್ಯಾನಲ್ ಪ್ರಸ್ತುತ ಸ್ಥಿತಿ ಮತ್ತು ಏಳು ದಿನದ ಮುನ್ನೋಟವನ್ನು ತೋರಿಸುತ್ತದೆ, ಈ ಪುಟ ತೆರೆದಾಗ ಲೋಡ್ ಆಗುತ್ತದೆ — ಮತ್ತು ಮುನ್ನೋಟವನ್ನು ಸರಳ ಸಲಹೆಯಾಗಿ ಪರಿವರ್ತಿಸುತ್ತದೆ: ಇಂದು ಛತ್ರಿ ಬೇಕೇ?'}
      </p>
    </div>

    <div class="mt-8 grid gap-5 md:grid-cols-3">
      {seasonCards.map(([t, d]) => (
        <article class="rounded-2xl border border-fort/15 bg-white/55 p-6">
          <h3 class="font-extrabold text-fort">{t}</h3>
          <p class="mt-2 text-sm leading-7 text-stone-ink/70">{d}</p>
        </article>
      ))}
    </div>

    <div id="bengaluru-weather" data-lang={en ? 'en' : 'kn'} class="mt-8 grid gap-5 lg:grid-cols-[.9fr_1.1fr]">
      <article class="arch-card min-w-0 flex flex-col p-7">
        <p class="text-xs font-extrabold tracking-wider text-fort">{en ? 'CURRENT CONDITIONS' : 'ಪ್ರಸ್ತುತ ಸ್ಥಿತಿ'}</p>
        <div id="wx-current" class="flex flex-1 flex-col items-center justify-center py-6 text-center">
          <div class="text-stone-ink/40">{en ? 'Loading live forecast…' : 'ಲೈವ್ ಮುನ್ನೋಟ ಲೋಡ್ ಆಗುತ್ತಿದೆ…'}</div>
        </div>
      </article>
      <article class="arch-card min-w-0 flex flex-col p-7">
        <p class="text-xs font-extrabold tracking-wider text-fort">{en ? '7-DAY OUTLOOK' : '7 ದಿನದ ಮುನ್ನೋಟ'}</p>
        <ol id="wx-daily" class="mt-4 flex flex-1 flex-col justify-center divide-y divide-fort/10 text-stone-ink/70">
          <li class="py-2 text-center text-sm">{en ? 'Forecast loads here automatically…' : 'ಮುನ್ನೋಟ ಇಲ್ಲಿ ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಲೋಡ್ ಆಗುತ್ತದೆ…'}</li>
        </ol>
      </article>
    </div>

    <div id="wx-advice" class="mt-5 hidden"></div>

    <noscript>
      <p class="mt-5 rounded-2xl border border-fort/20 bg-white/55 p-5 text-sm leading-7 text-stone-ink/70">
        {en
          ? 'JavaScript is disabled, so the live panel cannot load. The season cards above still give planning guidance; also check a national or regional forecast source before travelling.'
          : 'ಜಾವಾಸ್ಕ್ರಿಪ್ಟ್ ನಿಷ್ಕ್ರಿಯವಾಗಿದ್ದರಿಂದ ಲೈವ್ ಪ್ಯಾನಲ್ ಲೋಡ್ ಆಗುವುದಿಲ್ಲ. ಮೇಲಿನ ಋತು ಕಾರ್ಡ್‌ಗಳು ಯೋಜನೆಗೆ ಸಹಾಯಕ; ಪ್ರಯಾಣಿಸುವ ಮೊದಲು ರಾಷ್ಟ್ರೀಯ ಅಥವಾ ಪ್ರಾದೇಶಿಕ ಮುನ್ನೋಟ ಮೂಲ ಪರಿಶೀಲಿಸಿ.'}
      </p>
    </noscript>
    <p class="mt-5 text-xs leading-6 text-stone-ink/55">
      {en
        ? 'Open-Meteo model · Asia/Kolkata (UTC+5:30), not an on-site observation. Forecasts are indicative and can differ from official advisories. For warnings and alerts, consult the India Meteorological Department.'
        : 'Open-Meteo ಮಾದರಿ · Asia/Kolkata (UTC+5:30), ಸ್ಥಳದಲ್ಲಿನ ಮಾಪನವಲ್ಲ. ಮುನ್ನೋಟಗಳು ಸೂಚಕ ಮಾತ್ರ; ಅವು ಅಧಿಕೃತ ಮಾರ್ಗದರ್ಶನಕ್ಕಿಂತ ಭಿನ್ನವಾಗಬಹುದು. ಎಚ್ಚರಿಕೆಗಳಿಗಾಗಿ ಭಾರತ ಹವಾಮಾನ ಇಲಾಖೆಯನ್ನು (IMD) ಪರಿಶೀಲಿಸಿ.'}
    </p>
</section>

<script>
 import {initWeather} from '../lib/weather-client.js';
 initWeather();
</script>

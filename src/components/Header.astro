---
import Logo from './Logo.astro';
interface Props { lang?: 'kn-IN' | 'en-IN'; }
const { lang = 'kn-IN' } = Astro.props;
const en = lang === 'en-IN';
const root = en ? '/en/' : '/';
const switchHref = en ? '/' : '/en/';
---
<header class="sticky top-0 z-40 border-b border-fort-deep/10 bg-parchment/92 backdrop-blur">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 py-3 lg:px-8">
    <a href={root} aria-label={en ? 'Bengaluru Fort home' : 'ಬೆಂಗಳೂರು ಕೋಟೆ ಮುಖಪುಟ'}><Logo /></a>
    <nav aria-label={en ? 'Main navigation' : 'ಮುಖ್ಯ ನ್ಯಾವಿಗೇಶನ್'} class="hidden items-center gap-5 text-sm font-semibold lg:flex">
      <a class="focus-ring rounded hover:text-fort" href={`${root}#history`}>{en ? 'History' : 'ಇತಿಹಾಸ'}</a>
      <a class="focus-ring rounded hover:text-fort" href={`${root}#stories`}>{en ? 'Stories' : 'ಕಥೆಗಳು'}</a>
      <a class="focus-ring rounded hover:text-fort" href={`${root}#visit`}>{en ? 'Visit' : 'ಭೇಟಿ ಮಾಹಿತಿ'}</a>
      <a class="focus-ring rounded hover:text-fort" href={`${root}#transport`}>{en ? 'Transport' : 'ಸಾರಿಗೆ'}</a>
      <a class="focus-ring rounded hover:text-fort" href={`${root}#facilities`}>{en ? 'Facilities' : 'ಸೌಲಭ್ಯಗಳು'}</a>
      <a class="focus-ring rounded hover:text-fort" href={`${root}#season`}>{en ? 'Seasons' : 'ಋತುಗಳು'}</a>
      <a class="focus-ring rounded hover:text-fort" href={`${root}#itinerary`}>{en ? 'Plan' : 'ಯೋಜನೆ'}</a>
      <a class="focus-ring rounded hover:text-fort" href={`${root}#nearby`}>{en ? 'Nearby' : 'ಸುತ್ತಮುತ್ತ'}</a>
      <a class="focus-ring rounded hover:text-fort" href={`${root}#responsibility`}>{en ? 'Care' : 'ಜವಾಬ್ದಾರಿ'}</a>
      <a class="focus-ring rounded hover:text-fort" href={`${root}#faq`}>{en ? 'FAQ' : 'ಸಾಮಾನ್ಯ ಪ್ರಶ್ನೆಗಳು'}</a>
    </nav>
    <div class="flex items-center gap-2">
      <a class="focus-ring rounded-full border border-fort/25 px-3 py-2 text-xs font-extrabold text-fort hover:bg-white" href={switchHref} hreflang={en ? 'kn' : 'en'}>{en ? 'ಕನ್ನಡ' : 'English'}</a>
      <a class="focus-ring hidden rounded-full bg-fort px-4 py-2 text-sm font-bold text-white transition hover:bg-fort-deep sm:inline-flex" href={`${root}#map`}>{en ? 'View map' : 'ನಕ್ಷೆ ನೋಡಿ'}</a>
    </div>
  </div>
</header>

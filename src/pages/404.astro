---
import BaseLayout from '../layouts/BaseLayout.astro';
export const prerender = true;
---
<BaseLayout
  title="ಪುಟ ಸಿಗಲಿಲ್ಲ (404) | ಬೆಂಗಳೂರು ಕೋಟೆ ಪ್ರವಾಸಿ ಮಾರ್ಗದರ್ಶಿ"
  description="The page you requested was not found. / ನೀವು ಕೇಳಿದ ಪುಟ ಸಿಗಲಿಲ್ಲ."
  robots="noindex,follow"
>
  <section class="mx-auto flex min-h-[62vh] max-w-4xl flex-col items-center justify-center px-5 py-20 text-center lg:px-8">
    <p class="text-8xl font-black text-fort/20">404</p>
    <h1 class="section-title mt-2">ಪುಟ ಸಿಗಲಿಲ್ಲ</h1>
    <p class="mt-2 text-lg font-bold text-stone-ink/70">Page not found</p>
    <p class="mt-6 max-w-2xl leading-8 text-stone-ink/70">ನೀವು ಹುಡುಕುತ್ತಿರುವ ಪುಟ ಲಭ್ಯವಿಲ್ಲ ಅಥವಾ ಸರಿಸಲಾಗಿದೆ. ವಿಳಾಸದ ಕಾಗುಣಿತವನ್ನು ಪರಿಶೀಲಿಸಿ, ಅಥವಾ ಕೆಳಗಿನಿಂದ ಮುಖಪುಟಕ್ಕೆ ಹೋಗಿ.</p>
    <p class="mt-2 max-w-2xl text-sm leading-7 text-stone-ink/60">The page you are looking for does not exist or has been moved. Please check the address, or return to one of the home pages below.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="focus-ring rounded-full bg-fort px-6 py-3 font-extrabold text-white hover:bg-fort-deep">ಕನ್ನಡ ಮುಖಪುಟ</a>
      <a href="/en/" class="focus-ring rounded-full border border-fort/35 bg-white/40 px-6 py-3 font-extrabold text-fort hover:bg-white">English homepage</a>
    </div>
  </section>
</BaseLayout>

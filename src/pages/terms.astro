---
import BaseLayout from '../layouts/BaseLayout.astro';
export const prerender = true;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'ಸೇವಾ ನಿಯಮಗಳು',
  inLanguage: 'kn-IN',
  ...(Astro.site ? { url: new URL('/terms/', Astro.site).href } : {})
};
---
<BaseLayout title="ಸೇವಾ ನಿಯಮಗಳು | ಬೆಂಗಳೂರು ಕೋಟೆ ಪ್ರವಾಸಿ ಮಾರ್ಗದರ್ಶಿ" description="ಬೆಂಗಳೂರು ಕೋಟೆ ಪ್ರವಾಸಿ ಮಾರ್ಗದರ್ಶಿ ಬಳಸುವ ನಿಯಮಗಳು, ವಿಷಯದ ಮಿತಿ ಮತ್ತು ಕೃತಿಸ್ವಾಮ್ಯ ಮಾಹಿತಿ." jsonLd={jsonLd} alternatePath="/en/terms/">
  <section class="mx-auto max-w-4xl px-5 py-16 lg:px-8 lg:py-24">
    <a href="/" class="text-sm font-bold text-fort underline">← ಮುಖಪುಟಕ್ಕೆ ಹಿಂತಿರುಗಿ</a>
    <p class="section-kicker mt-10">ಕಾನೂನು ಮಾಹಿತಿ</p>
    <h1 class="section-title">ಸೇವಾ ನಿಯಮಗಳು</h1>
    <p class="mt-3 text-sm text-stone-ink/60">ಕೊನೆಯ ಪರಿಷ್ಕರಣೆ: ಸೆಪ್ಟೆಂಬರ್ 2026</p>
    <div class="policy mt-10">
      <p>ಈ ತಾಣವನ್ನು ಪ್ರವೇಶಿಸುವ ಅಥವಾ ಬಳಸುವ ಮೂಲಕ ಈ ಸೇವಾ ನಿಯಮಗಳಿಗೆ ನೀವು ಒಪ್ಪುತ್ತೀರಿ. ಈ ತಾಣವು ಬೆಂಗಳೂರು ಕೋಟೆಯ ಕುರಿತು ಸ್ವತಂತ್ರ, ಲಾಭರಹಿತ ಪ್ರವಾಸಿ ಮಾಹಿತಿ ಮಾರ್ಗದರ್ಶಿ ಮಾತ್ರ.</p>

      <h2>ಅಧಿಕೃತವಲ್ಲದ ಸ್ವರೂಪ</h2>
      <p>ಈ ಯೋಜನೆ ಭಾರತೀಯ ಪುರಾತತ್ವ ಸರ್ವೇಕ್ಷಣಾ ಇಲಾಖೆ, ಗ್ರೇಟರ್ ಬೆಂಗಳೂರು ಅಥಾರಿಟಿ, ಬೆಂಗಳೂರು ನಗರ ಜಿಲ್ಲಾಡಳಿತ, ಕರ್ನಾಟಕ ಪ್ರವಾಸೋದ್ಯಮ ಇಲಾಖೆ, ಭಾರತ ಸರ್ಕಾರ ಅಥವಾ ಯಾವುದೇ ವಾಣಿಜ್ಯ ಪ್ರವಾಸಿ ಆಪರೇಟರ್‌ನ ಅಧಿಕೃತ ತಾಣವಲ್ಲ ಮತ್ತು ಅವುಗಳೊಂದಿಗೆ ಯಾವುದೇ ಆಡಳಿತಾತ್ಮಕ ಸಂಬಂಧವನ್ನು ಹೇಳಿಕೊಳ್ಳುವುದಿಲ್ಲ.</p>

      <h2>ವಿಷಯದ ಬಳಕೆ</h2>
      <p>ತಾಣದ ಮೂಲ ಬರಹ, ವಿನ್ಯಾಸ ಮತ್ತು ಸಂಯೋಜಿತ ಮಾರ್ಗದರ್ಶಿ ವಿಷಯವನ್ನು ವೈಯಕ್ತಿಕ ಮಾಹಿತಿ ಉದ್ದೇಶಕ್ಕೆ ಬಳಸಬಹುದು. ಕೃತಿಸ್ವಾಮ್ಯದಿಂದ ರಕ್ಷಿತ ಮೂಲ ವಿಷಯವನ್ನು ಅನುಮತಿಯಿಲ್ಲದೆ ದೊಡ್ಡ ಪ್ರಮಾಣದಲ್ಲಿ ನಕಲಿಸುವುದು, ಮರುಪ್ರಕಟಿಸುವುದು ಅಥವಾ ತಪ್ಪು ಅಧಿಕೃತ ಪ್ರತಿನಿಧಿತ್ವಕ್ಕೆ ಬಳಸುವುದು ಅನುಮತಿಸಲ್ಪಟ್ಟಿಲ್ಲ.</p>

      <h2>ಮಾಹಿತಿಯ ನಿಖರತೆ</h2>
      <p>ಇತಿಹಾಸ ಮತ್ತು ಸ್ಥಳ ಗುರುತನ್ನು ಅಧಿಕಾರಪೂರ್ಣ ಸಾರ್ವಜನಿಕ ಮೂಲಗಳೊಂದಿಗೆ ಹೋಲಿಸಿ ನೀಡಲು ಪ್ರಯತ್ನಿಸಲಾಗಿದೆ. ಆದಾಗ್ಯೂ ಭೇಟಿ ಸಮಯ, ಟಿಕೆಟ್, ಪ್ರವೇಶ ನಿಯಮ, ರಸ್ತೆ ಸ್ಥಿತಿ, ಪಾರ್ಕಿಂಗ್, ಸಾರಿಗೆ ಸೇವೆ ಮತ್ತು ಸೌಲಭ್ಯಗಳು ಸೂಚನೆ ಇಲ್ಲದೆ ಬದಲಾಗಬಹುದು. ಪ್ರಯಾಣಕ್ಕೂ ಮುನ್ನ ಸಂಬಂಧಿತ ಅಧಿಕೃತ ಮೂಲ ಅಥವಾ ಸ್ಥಳದ ಪ್ರಕಟಣೆಯನ್ನು ಪರಿಶೀಲಿಸುವುದು ನಿಮ್ಮ ಜವಾಬ್ದಾರಿ.</p>

      <h2>ವಾಣಿಜ್ಯ ಪ್ರಭಾವ ಇಲ್ಲ</h2>
      <p>“ಸುತ್ತಮುತ್ತಲಿನ ಊಟ” ಅಥವಾ “ಸುತ್ತಮುತ್ತಲಿನ ಸ್ಥಳಗಳು” ವಿಭಾಗಗಳು ಪಾವತಿತ ಪ್ರಚಾರ, ಜಾಹೀರಾತು ಶ್ರೇಯಾಂಕ ಅಥವಾ ಕಮಿಷನ್ ಆಧಾರಿತ ಶಿಫಾರಸುಗಳಲ್ಲ. ಅವು ಭೌಗೋಳಿಕ ಮತ್ತು ಸಾಂಸ್ಕೃತಿಕ ಸಂದರ್ಭ ನೀಡಲು ಮಾತ್ರ.</p>

      <h2>ಕೃತಿಸ್ವಾಮ್ಯ ಮತ್ತು ಚಿತ್ರ ಪರವಾನಗಿ</h2>
      <p>ಈ ತಾಣದ ವಿನ್ಯಾಸ ಮತ್ತು ಮೂಲ ಬರಹದ ಕೃತಿಸ್ವಾಮ್ಯ ಯೋಜನೆಗೆ ಸೇರಿದೆ. ಛಾಯಾಚಿತ್ರಗಳ ಕೃತಿಸ್ವಾಮ್ಯ ಮೂಲ ಛಾಯಾಗ್ರಾಹಕರದ್ದೇ. ವಿಕಿಮೀಡಿಯ ಕಾಮನ್ಸ್‌ನಿಂದ ಬಳಸಿದ ಚಿತ್ರಗಳಿಗೆ ಮುಖ್ಯ ಪುಟದಲ್ಲಿ ಛಾಯಾಗ್ರಾಹಕ, ಮೂಲ ಮತ್ತು ಅನ್ವಯಿಸುವ ಕ್ರಿಯೇಟಿವ್ ಕಾಮನ್ಸ್ ಪರವಾನಗಿ ನೀಡಲಾಗಿದೆ. ಗೂಗಲ್ ನಕ್ಷೆ ಡೇಟಾ ಮತ್ತು ಸೇವೆಯ ಬಳಕೆ ಗೂಗಲ್‌ನ ಅನ್ವಯಿಸುವ ನಿಯಮಗಳಿಗೆ ಒಳಪಟ್ಟಿರುತ್ತದೆ.</p>

      <h2>ಹೊರಗಿನ ಲಿಂಕ್‌ಗಳು</h2>
      <p>ಅಧಿಕೃತ ಅಥವಾ ಉಲ್ಲೇಖ ಮೂಲಗಳಿಗೆ ಹೊರಗಿನ ಲಿಂಕ್‌ಗಳನ್ನು ನೀಡಬಹುದು. ಆ ತಾಣಗಳ ವಿಷಯ, ಲಭ್ಯತೆ, ಭದ್ರತೆ ಅಥವಾ ನೀತಿಗಳ ಮೇಲೆ ನಮ್ಮ ನಿಯಂತ್ರಣವಿಲ್ಲ.</p>

      <h2>ಹೊಣೆಗಾರಿಕೆಯ ಮಿತಿ</h2>
      <p>ಈ ತಾಣವನ್ನು “ಇದ್ದ ಸ್ಥಿತಿಯಲ್ಲೇ” ಮಾಹಿತಿ ಉದ್ದೇಶಕ್ಕೆ ನೀಡಲಾಗುತ್ತದೆ. ಅನ್ವಯಿಸುವ ಕಾನೂನು ಅನುಮತಿಸುವ ಮಿತಿಯೊಳಗೆ, ತಾಣದ ಮಾಹಿತಿಯನ್ನು ಆಧರಿಸಿದ ಪ್ರಯಾಣ ನಿರ್ಧಾರ, ವೇಳಾಪಟ್ಟಿ ಬದಲಾವಣೆ, ವೆಚ್ಚ, ಸಾರಿಗೆ ವಿಳಂಬ, ಪ್ರವೇಶ ನಿರಾಕರಣೆ ಅಥವಾ ಇತರೆ ನಷ್ಟಗಳಿಗೆ ಯೋಜನೆ ಹೊಣೆ ಹೊರುವುದಿಲ್ಲ.</p>

      <h2>ನಿಯಮಗಳ ಬದಲಾವಣೆ</h2>
      <p>ಕಾನೂನು, ಸೇವೆ ಅಥವಾ ವಿಷಯದ ಸ್ವರೂಪ ಬದಲಾಗಿದಾಗ ಈ ನಿಯಮಗಳನ್ನು ನವೀಕರಿಸಬಹುದು. ನವೀಕೃತ ಆವೃತ್ತಿಯೇ ಈ ಪುಟದಲ್ಲಿ ಅನ್ವಯಿಸುತ್ತದೆ.</p>
    </div>
  </section>
</BaseLayout>

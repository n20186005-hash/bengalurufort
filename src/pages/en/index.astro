---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StoriesSection from '../../components/StoriesSection.astro';
import FacilitiesSection from '../../components/FacilitiesSection.astro';
import WeatherSection from '../../components/WeatherSection.astro';
export const prerender = true;

const pageUrl = Astro.site ? new URL('/en/', Astro.site).href : undefined;
const attractionId = Astro.site ? new URL('#attraction', Astro.site).href : undefined;
const mapsUrl = 'https://maps.app.goo.gl/YQMDNDs39ST6udZd6';
const imageUrl = Astro.site ? new URL('/images/bengaluru-fort-courtyard.jpg', Astro.site).href : '/images/bengaluru-fort-courtyard.jpg';

const attraction = {
  '@context': 'https://schema.org',
  '@type': 'TouristAttraction',
  '@id': attractionId,
  name: 'Bengaluru Fort',
  alternateName: ['ಬೆಂಗಳೂರು ಕೋಟೆ', 'Bangalore Fort', 'Old Dungeon Fort and Gates'],
  description: 'Comprehensive visitor guide to Bengaluru Fort in Bengaluru, Karnataka, India — the surviving centrally protected gateway and walls of Kempe Gowda I’s 1537 fort, later rebuilt in stone under Hyder Ali.',
  ...(pageUrl ? { url: pageUrl } : {}),
  image: [imageUrl],
  isAccessibleForFree: true,
  publicAccess: true,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Krishna Rajendra Rd, New Tharagupet',
    addressLocality: 'Bengaluru',
    addressRegion: 'Karnataka',
    postalCode: '560002',
    addressCountry: 'IN'
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 12.962802,
    longitude: 77.573311
  },
  hasMap: mapsUrl,
  openingHours: 'Mo-Su 08:30-17:30',
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.0',
    reviewCount: '26832',
    bestRating: '5',
    worstRating: '1'
  },
  inLanguage: 'en-IN',
  sameAs: [
    mapsUrl,
    'https://karnatakatourism.org/en/destinations/bengaluru',
    'https://bengaluruurban.nic.in/en/history/',
    'https://asi.nic.in/admin/whatsnew/download/719'
  ]
};

const faqItems = [
  ['Who built Bengaluru Fort?', 'Kempe Gowda I established the early mud fort in 1537. Hyder Ali later strengthened the fort in stone around 1761.'],
  ['How long should I spend at the fort?', 'About 45–75 minutes is usually enough for the surviving gateway, walls, bastions and courtyard. Allow 3–4 hours if you combine it with nearby old-Bengaluru heritage sites.'],
  ['Is there an entry fee?', 'Recent visitor listings commonly report free entry, but operating rules can change. Treat the notice at the monument or current Archaeological Survey of India information as authoritative on the day you visit.'],
  ['What is the best time to visit?', 'Early morning is usually the easiest time for walking and photography and avoids some of the midday heat and old-city traffic. Bengaluru is generally pleasant for outdoor sightseeing from October to February.'],
  ['Which metro station is convenient?', 'K.R. Market and Chickpet are practical metro approaches for this part of the old city. Check the current Namma Metro map before travelling because access arrangements can change.'],
  ['Is car parking easy?', 'The fort is in a dense market district. Do not assume a large dedicated tourist car park is available at the monument; public transport or a lawful paid parking facility is usually simpler.'],
  ['Are there toilets, food and ATMs nearby?', 'No reliable public toilets or eateries are guaranteed inside the monument grounds. The K.R. Market–Chickpet area offers public conveniences, small eateries, shops and ATMs; judge hygiene, prices and availability on the spot.'],
  ['Can I take photographs at the fort?', 'As an open-air monument, casual visitor photography is generally fine. For commercial filming, drones or special equipment, check the current Archaeological Survey of India or on-site guidance, and avoid blocking the busy pavement.'],
  ['Are Bengaluru Fort and Tipu Sultan’s Summer Palace the same site?', 'No — they are separate centrally protected monuments. The Summer Palace lies a short distance away in the old city; plan it as a distinct visit rather than part of the fort.']
];
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: 'en-IN',
  mainEntity: faqItems.map(([q,a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } }))
};
const jsonLd = [attraction, faqSchema];
const mapSrc = 'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d6915.626518291582!2d77.57331127700142!3d12.962801787351749!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3bae15e3043a1d57%3A0xb2a4590209bde6d7!2sBengaluru%20Fort!5e1!3m2!1sen!2sin!4v1788419693020!5m2!1sen!2sin';
---
<BaseLayout
  lang="en-IN"
  alternatePath="/"
  title="Bengaluru Fort (Bengaluru, Karnataka) | Visitor Guide, Map & History"
  description="Independent guide to Bengaluru Fort (ಬೆಂಗಳೂರು ಕೋಟೆ), the surviving gateway of Kempe Gowda's 1537 fort on Krishna Rajendra Road in Bengaluru, Karnataka 560002, India: history, visiting hours, nearby Tipu Sultan's Summer Palace & Kote Venkataramana Temple, facilities, live weather, transport and map."
  jsonLd={jsonLd}
>
  <section class="relative isolate overflow-hidden bg-[#302820] text-white">
    <img src="/images/bengaluru-fort-courtyard.jpg" alt="Main view of Bengaluru Fort — surviving stone gateway, arched entrance and green courtyard in Bengaluru, Karnataka, India" class="absolute inset-0 -z-20 h-full w-full object-cover" width="1280" height="850" fetchpriority="high" />
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-[#241d17]/95 via-[#33261d]/72 to-[#33261d]/30"></div>
    <div class="mx-auto grid min-h-[78vh] max-w-7xl items-end gap-10 px-5 py-16 lg:grid-cols-[1.1fr_.6fr] lg:px-8 lg:py-24">
      <div class="max-w-3xl">
        <p class="mb-4 inline-flex rounded-full border border-white/25 bg-black/20 px-4 py-2 text-sm font-bold backdrop-blur">Centrally protected ASI monument · N-KA-B1</p>
        <h1 class="text-5xl font-black leading-[1.05] sm:text-6xl lg:text-8xl">Bengaluru Fort<span class="mt-3 block text-2xl font-extrabold tracking-wide text-[#e9cda7] sm:text-3xl">in Bengaluru · Karnataka · India</span></h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-[#f4e7d4] sm:text-xl">From Kempe Gowda I’s 1537 mud fort to Hyder Ali’s stone defences, this surviving gateway keeps a physical link to the making of Bengaluru’s old city.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#visit" class="focus-ring rounded-full bg-[#e9cda7] px-5 py-3 font-extrabold text-[#33261d] hover:bg-white">Plan your visit</a>
          <a href="#map" class="focus-ring rounded-full border border-white/35 bg-white/10 px-5 py-3 font-extrabold backdrop-blur hover:bg-white/20">Open map</a>
        </div>
      </div>
      <aside class="arch-card border-white/20 bg-black/35 p-6 text-white backdrop-blur-md">
        <p class="text-xs font-bold tracking-wider text-[#e9cda7]">PLACE IDENTITY</p>
        <p class="mt-2 text-lg font-bold">Krishna Rajendra Road, New Tharagupet</p>
        <p class="mt-2 text-sm leading-7 text-white/75">Bengaluru · Karnataka 560002 · India</p>
        <div class="mt-5 grid grid-cols-2 gap-3 border-t border-white/15 pt-5 text-sm">
          <div><span class="block text-white/60">Listed rating</span><strong class="text-lg">4.0 / 5</strong></div>
          <div><span class="block text-white/60">Reviews</span><strong class="text-lg">26,832</strong></div>
        </div>
      </aside>
    </div>
  </section>

  <section class="border-y border-fort/10 bg-white/50" aria-label="Introduction">
    <div class="mx-auto max-w-7xl px-5 py-7 lg:px-8">
      <nav aria-label="Breadcrumb" class="text-xs font-bold uppercase tracking-wider text-stone-ink/55">
        <ol class="flex flex-wrap items-center gap-2">
          <li>Bengaluru Fort</li><li aria-hidden="true">›</li>
          <li>Bengaluru</li><li aria-hidden="true">›</li>
          <li>Karnataka</li><li aria-hidden="true">›</li>
          <li>India</li>
        </ol>
      </nav>
      <p class="mt-3 max-w-4xl leading-8 text-stone-ink/75"><strong>Bengaluru Fort (ಬೆಂಗಳೂರು ಕೋಟೆ)</strong> is the centrally protected surviving gateway of the fort Kempe Gowda built in 1537, standing in the heart of old <strong>Bengaluru, Karnataka, India</strong> and listed by the Archaeological Survey of India as “Old Dungeon Fort and Gates”.</p>
    </div>
  </section>

  <section id="history" class="mx-auto max-w-7xl px-5 py-20 lg:px-8 lg:py-28">
    <div class="grid gap-12 lg:grid-cols-[.9fr_1.1fr] lg:items-start">
      <div class="lg:sticky lg:top-28">
        <p class="section-kicker">THE CITY'S EARLY LAYERS</p>
        <h2 class="section-title">A fort tied directly to Bengaluru’s foundation story</h2>
        <p class="mt-5 max-w-xl leading-8 text-stone-ink/70">Bengaluru Urban District Administration records that Kempe Gowda built a mud fort in 1537 and laid the foundation of modern Bengaluru. The Archaeological Survey of India lists the surviving protected monument as “Old Dungeon Fort and Gates”.</p>
        <div class="mt-7 flex flex-wrap gap-3 text-sm font-bold">
          <a rel="external noopener" href="https://bengaluruurban.nic.in/en/history/" class="rounded-full border border-fort/30 px-4 py-2 hover:bg-white">District history source</a>
          <a rel="external noopener" href="https://asi.nic.in/admin/whatsnew/download/719" class="rounded-full border border-fort/30 px-4 py-2 hover:bg-white">ASI protected-monument list</a>
        </div>
      </div>
      <div class="space-y-6">
        <article class="arch-card p-7 sm:p-9"><span class="text-3xl font-black text-fort">1537</span><h3 class="mt-3 text-xl font-extrabold">Kempe Gowda I’s mud fort</h3><p class="mt-3 leading-8 text-stone-ink/70">The early fort formed part of the foundation of the settlement that grew into modern Bengaluru under the wider Vijayanagara political world.</p></article>
        <article class="arch-card p-7 sm:p-9"><span class="text-3xl font-black text-fort">1761</span><h3 class="mt-3 text-xl font-extrabold">Strengthened in stone under Hyder Ali</h3><p class="mt-3 leading-8 text-stone-ink/70">Hyder Ali reinforced the defensive enclosure in stone. Bengaluru remained an important military centre under Tipu Sultan.</p></article>
        <article class="arch-card p-7 sm:p-9"><span class="text-3xl font-black text-fort">1791</span><h3 class="mt-3 text-xl font-extrabold">A turning point in the Third Anglo-Mysore War</h3><p class="mt-3 leading-8 text-stone-ink/70">British forces captured Bengaluru Fort during the 1791 campaign. Much of the larger fortification later disappeared, leaving the protected gateway, walls and bastion elements visible today.</p></article>
      </div>
    </div>
  </section>

  <section class="bg-[#e8d8bf] py-20">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="grid gap-5 md:grid-cols-3">
        <figure class="overflow-hidden rounded-[2.2rem_2.2rem_.8rem_.8rem] bg-[#31281f] text-white md:col-span-2"><img src="/images/bengaluru-fort-panorama.jpg" alt="Wide view of Bengaluru Fort's historic gateway and stone walls" class="aspect-[16/8] h-full min-h-[330px] w-full object-cover" loading="lazy" width="1280" height="435" /></figure>
        <figure class="overflow-hidden rounded-[2.2rem_2.2rem_.8rem_.8rem] bg-[#31281f] text-white"><img src="/images/bengaluru-fort-arch.jpg" alt="Historic arch and masonry at Bengaluru Fort" class="aspect-[4/5] h-full min-h-[330px] w-full object-cover" loading="lazy" width="960" height="1280" /></figure>
      </div>
    </div>
  </section>

  <section id="visit" class="mx-auto max-w-7xl px-5 py-20 lg:px-8 lg:py-28">
    <p class="section-kicker">PRACTICAL INFORMATION</p>
    <h2 class="section-title max-w-3xl">What to know before visiting</h2>
    <div class="mt-10 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
      <article class="arch-card p-6"><div class="text-2xl">◷</div><h3 class="mt-4 font-extrabold">Published visiting hours</h3><p class="mt-2 text-sm leading-7 text-stone-ink/70">Most current visitor listings show 8:30am–5:30pm daily. Holiday or maintenance closures can change; the notice at the monument takes precedence.</p></article>
      <article class="arch-card p-6"><div class="text-2xl">⌛</div><h3 class="mt-4 font-extrabold">Suggested duration</h3><p class="mt-2 text-sm leading-7 text-stone-ink/70">Fort only: around 45–75 minutes. Allow 3–4 hours for a broader old-city heritage walk.</p></article>
      <article class="arch-card p-6"><div class="text-2xl">₹</div><h3 class="mt-4 font-extrabold">Tickets / cost</h3><p class="mt-2 text-sm leading-7 text-stone-ink/70">Recent visitor listings commonly report free entry. Verify current admission rules on the ASI or on-site notice before travel rather than relying on an old fee figure.</p></article>
      <article class="arch-card p-6"><div class="text-2xl">☀</div><h3 class="mt-4 font-extrabold">Best time</h3><p class="mt-2 text-sm leading-7 text-stone-ink/70">Early morning is good for walking and photography. October–February is generally Bengaluru’s most comfortable period for outdoor sightseeing.</p></article>
    </div>
    <div class="mt-8 rounded-2xl border border-fort/20 bg-white/55 p-5 text-sm leading-7 text-stone-ink/70"><strong class="text-stone-ink">Important:</strong> opening hours, admission rules and security arrangements may change temporarily. Check the monument notice or current Archaeological Survey of India information on the day of travel.</div>
  </section>

  <section class="bg-[#382e26] py-20 text-white">
    <div class="mx-auto grid max-w-7xl gap-10 px-5 lg:grid-cols-[.9fr_1.1fr] lg:px-8">
      <div><p class="text-xs font-extrabold tracking-wider text-[#e9cda7]">DEFENSIVE DETAILS IN STONE AND TIMBER</p><h2 class="mt-3 text-4xl font-black leading-tight sm:text-5xl">Arches, bastions and the spiked fort gate</h2><p class="mt-5 leading-8 text-white/70">The surviving fabric shows thick masonry, curved bastion forms, a recessed gateway sequence and heavy timber doors. Iron spikes on the gate are a vivid reminder of defensive architecture designed for an age of elephant assaults.</p></div>
      <figure class="overflow-hidden rounded-[3rem_3rem_1rem_1rem] border border-white/10"><img src="/images/bengaluru-fort-spiked-gate.jpg" alt="Iron defensive spikes fixed to the heavy wooden gate at Bengaluru Fort" class="aspect-[3/2] w-full object-cover" loading="lazy" width="958" height="639" /></figure>
    </div>
  </section>

  <StoriesSection lang="en-IN" />

  <section id="transport" class="mx-auto max-w-7xl px-5 py-20 lg:px-8 lg:py-28">
    <p class="section-kicker">DETAILED TRANSPORT</p>
    <h2 class="section-title">Reaching the fort in Bengaluru’s busy old-city core</h2>
    <div class="mt-10 grid gap-6 lg:grid-cols-3">
      <article class="arch-card p-7"><h3 class="text-xl font-extrabold">Metro</h3><p class="mt-3 leading-8 text-stone-ink/70">Use the K.R. Market or Chickpet side of the Namma Metro network, then continue on foot or by short auto ride. Check the current official network map before departure.</p><a class="mt-4 inline-block text-sm font-bold text-fort underline" rel="external noopener" href="https://english.bmrc.co.in/">Namma Metro official information</a></article>
      <article class="arch-card p-7"><h3 class="text-xl font-extrabold">Bus and auto-rickshaw</h3><p class="mt-3 leading-8 text-stone-ink/70">Many city bus routes serve K.R. Market, Kalasipalya and City Market. An auto is useful for the final leg; confirm the meter or app fare before travelling.</p></article>
      <article class="arch-card p-7"><h3 class="text-xl font-extrabold">Rail and airport</h3><p class="mt-3 leading-8 text-stone-ink/70">From Krantivira Sangolli Rayanna Bengaluru City station, metro, auto and taxi links are practical. From Kempegowda International Airport, use an airport bus or taxi to the city centre and continue locally.</p></article>
    </div>
    <div class="mt-12 grid gap-6 lg:grid-cols-2">
      <article class="rounded-3xl bg-moss p-8 text-white"><p class="text-xs font-bold tracking-wider text-white/60">PARKING</p><h3 class="mt-2 text-2xl font-extrabold">Public transport is usually simpler than driving</h3><p class="mt-4 leading-8 text-white/75">New Tharagupet and K.R. Market carry heavy commercial traffic. Do not rely on a large dedicated tourist car park at the fort. Use a lawful paid parking facility and keep narrow approaches and emergency access clear.</p></article>
      <article class="rounded-3xl border border-fort/20 bg-white/50 p-8"><p class="text-xs font-bold tracking-wider text-fort">WALKING PLAN</p><h3 class="mt-2 text-2xl font-extrabold">Fort first, then an old-Bengaluru heritage circuit</h3><p class="mt-4 leading-8 text-stone-ink/70">Bengaluru Fort, Tipu Sultan’s Summer Palace, Kote Venkataramana Swamy Temple and K.R. Market can be combined in the same old-city area. Footpaths are not continuous everywhere, so take care at road crossings.</p></article>
    </div>
  </section>

  <FacilitiesSection lang="en-IN" />
  <WeatherSection lang="en-IN" />

  <section id="nearby" class="bg-[#eadbc3] py-20 lg:py-24">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="grid gap-12 lg:grid-cols-2">
        <div><p class="section-kicker">NEARBY SIGHTS</p><h2 class="section-title">More history in the same old-city area</h2><p class="mt-4 leading-8 text-stone-ink/70">When visiting <strong>Bengaluru Fort</strong>, you can easily explore surrounding historic landmarks, including <strong>Tipu Sultan’s Summer Palace</strong> and the <strong>Kote Venkataramana Swamy Temple</strong> — all within a short walk or ride in the same old-city area.</p><div class="mt-8 space-y-4">
          <article class="rounded-2xl bg-white/55 p-6"><h3 class="font-extrabold">Tipu Sultan’s Summer Palace</h3><p class="mt-2 text-sm leading-7 text-stone-ink/70">A separate centrally protected monument with timber columns and arches. Do not confuse the palace with Bengaluru Fort itself.</p></article>
          <article class="rounded-2xl bg-white/55 p-6"><h3 class="font-extrabold">Kote Venkataramana Swamy Temple</h3><p class="mt-2 text-sm leading-7 text-stone-ink/70">A historic temple built in 1689 in the period of Chikkadevaraja Wodeyar, adding a religious and architectural layer to the old fort area.</p></article>
          <article class="rounded-2xl bg-white/55 p-6"><h3 class="font-extrabold">K.R. Market</h3><p class="mt-2 text-sm leading-7 text-stone-ink/70">A busy old Bengaluru market known for flowers, fruit, vegetables and daily trade, especially lively in the morning.</p></article>
          <article class="rounded-2xl bg-white/55 p-6"><h3 class="font-extrabold">Lalbagh Botanical Garden</h3><p class="mt-2 text-sm leading-7 text-stone-ink/70">A historic garden begun under Hyder Ali and expanded in Tipu Sultan’s era, useful as a green counterpoint after the fort.</p></article>
        </div></div>
        <div><p class="section-kicker">NEARBY FOOD</p><h2 class="section-title">Old Bengaluru food traditions nearby</h2><p class="mt-4 text-sm leading-7 text-stone-ink/65">These are contextual examples, not paid rankings or endorsements.</p><div class="mt-8 grid gap-4 sm:grid-cols-2">
          <article class="arch-card p-6"><h3 class="font-extrabold">Mavalli Tiffin Rooms</h3><p class="mt-2 text-sm leading-7 text-stone-ink/70">A long-running South Indian vegetarian institution on Lalbagh Road, associated with rava idli, dosa and bisibele bath.</p><a class="mt-3 inline-block text-xs font-bold text-fort underline" rel="external noopener" href="https://www.mavallitiffinrooms.com/">Official site</a></article>
          <article class="arch-card p-6"><h3 class="font-extrabold">Vidyarthi Bhavan</h3><p class="mt-2 text-sm leading-7 text-stone-ink/70">A traditional Gandhi Bazaar breakfast stop widely known for masala dosa and old-Bengaluru dining culture.</p><a class="mt-3 inline-block text-xs font-bold text-fort underline" rel="external noopener" href="https://vidyarthibhavan.in/">Official site</a></article>
          <article class="arch-card p-6 sm:col-span-2"><h3 class="font-extrabold">Darshinis and breakfast shops around the market area</h3><p class="mt-2 text-sm leading-7 text-stone-ink/70">K.R. Market and Chickpet have many small places serving idli, vada, dosa, khara bath and filter coffee. Check hygiene, posted prices and allergy needs yourself.</p></article>
        </div></div>
      </div>
    </div>
  </section>

  <section id="map" class="mx-auto max-w-7xl px-5 py-20 lg:px-8 lg:py-28">
    <div class="mb-8 max-w-3xl"><p class="section-kicker">LOCATION & DIRECTIONS</p><h2 class="section-title">Bengaluru Fort on Krishna Rajendra Road</h2><p class="mt-4 leading-8 text-stone-ink/70">Address: XH7G+49C, Krishna Rajendra Rd, New Tharagupet, Bengaluru, Karnataka 560002, India. For official updates and regional tourism information, visit the <a class="font-bold text-fort underline" rel="external noopener" href="https://karnatakatourism.org/en/destinations/bengaluru">Karnataka Tourism Department – Bengaluru</a> page and the <a class="font-bold text-fort underline" rel="external noopener" href="https://www.incredibleindia.gov.in/en/karnataka/bengaluru">Incredible India – Karnataka</a> page.</p></div>
    <div class="overflow-hidden rounded-[2.5rem_2.5rem_1rem_1rem] border border-fort/20 bg-white shadow-xl shadow-fort/5"><iframe src={mapSrc} title="Google map showing Bengaluru Fort" class="h-[520px] w-full" style="border:0" allowfullscreen loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe></div>
    <a class="mt-5 inline-flex rounded-full border border-fort/30 px-5 py-3 text-sm font-extrabold text-fort hover:bg-white" rel="external noopener" href={mapsUrl}>Open in Google Maps</a>
  </section>

  <section id="faq" class="bg-[#342b24] py-20 text-white lg:py-24">
    <div class="mx-auto max-w-5xl px-5 lg:px-8"><p class="text-xs font-extrabold tracking-wider text-[#e9cda7]">FREQUENTLY ASKED QUESTIONS</p><h2 class="mt-3 text-4xl font-black sm:text-5xl">Questions to check before visiting</h2><div class="mt-10 divide-y divide-white/10 border-y border-white/10">{faqItems.map(([q,a]) => <details class="group py-5"><summary class="cursor-pointer list-none pr-8 text-lg font-extrabold">{q}<span class="float-right text-[#e9cda7] group-open:rotate-45">＋</span></summary><p class="mt-4 max-w-3xl leading-8 text-white/70">{a}</p></details>)}</div></div>
  </section>

  <section class="mx-auto max-w-7xl px-5 py-20 lg:px-8">
    <div class="grid gap-10 lg:grid-cols-[.8fr_1.2fr]">
      <div><p class="section-kicker">SOURCES & IMAGE RIGHTS</p><h2 class="section-title">Evidence-led visitor information</h2><p class="mt-4 leading-8 text-stone-ink/70">The fort’s identity, protected status, location and history are tied to public authority sources. Photographs are stored locally rather than hotlinked at runtime, and photographer/licence credits are retained here.</p>
        <h3 class="mt-7 text-sm font-extrabold tracking-wide text-stone-ink">Primary official sources</h3>
        <ul class="mt-3 space-y-2.5 text-sm leading-6">
          <li><a class="font-bold text-fort underline" rel="external noopener" href="https://bengaluruurban.nic.in/en/history/">Bengaluru Urban District Administration – History</a></li>
          <li><a class="font-bold text-fort underline" rel="external noopener" href="https://karnatakatourism.org/en/destinations/bengaluru">Karnataka Tourism Department – Bengaluru</a></li>
          <li><a class="font-bold text-fort underline" rel="external noopener" href="https://www.incredibleindia.gov.in/en/karnataka/bengaluru">Government of India – Incredible India</a></li>
          <li><a class="font-bold text-fort underline" rel="external noopener" href="https://asi.nic.in/admin/whatsnew/download/719">Archaeological Survey of India – Protected Monuments List</a></li>
        </ul>
      </div>
      <div class="space-y-4 text-sm leading-7 text-stone-ink/70">

---
import BaseLayout from '../layouts/BaseLayout.astro';
export const prerender = true;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'ಕುಕಿ ಸೆಟ್ಟಿಂಗ್‌ಗಳು',
  inLanguage: 'kn-IN',
  ...(Astro.site ? { url: new URL('/cookies/', Astro.site).href } : {})
};
---
<BaseLayout title="ಕುಕಿ ಸೆಟ್ಟಿಂಗ್‌ಗಳು | ಬೆಂಗಳೂರು ಕೋಟೆ ಬೆಂಗಳೂರು — ಪ್ರವಾಸಿ ಮಾರ್ಗದರ್ಶಿ" description="ಅಗತ್ಯ, ವಿಶ್ಲೇಷಣಾ, ಆದ್ಯತೆ ಮತ್ತು ಮಾರ್ಕೆಟಿಂಗ್ ಕುಕಿಗಳ ಕುರಿತು ಮಾಹಿತಿ ಹಾಗೂ ನಿಮ್ಮ ಆಯ್ಕೆಗಳನ್ನು ನಿರ್ವಹಿಸುವ ಪುಟ." jsonLd={jsonLd} alternatePath="/en/cookies/">
  <section class="mx-auto max-w-5xl px-5 py-16 lg:px-8 lg:py-24">
    <a href="/" class="text-sm font-bold text-fort underline">← ಮುಖಪುಟಕ್ಕೆ ಹಿಂತಿರುಗಿ</a>
    <p class="section-kicker mt-10">ನಿಮ್ಮ ಆಯ್ಕೆ</p>
    <h1 class="section-title">ಕುಕಿ ಸೆಟ್ಟಿಂಗ್‌ಗಳು</h1>
    <p class="mt-3 text-sm text-stone-ink/60">ಕೊನೆಯ ಪರಿಷ್ಕರಣೆ: 25 ಅಕ್ಟೋಬರ್ 2026</p>
    <p class="mt-7 max-w-3xl leading-8 text-stone-ink/70">ತಾಣದ ಕಾರ್ಯಾಚರಣೆಗೆ ಅಗತ್ಯವಿರುವ ಕನಿಷ್ಠ ಸ್ಥಳೀಯ ಸಂಗ್ರಹಣೆಯನ್ನು ಬಳಸುತ್ತೇವೆ. ವಿಶ್ಲೇಷಣೆ ಪೂರ್ವನಿಯೋಜಿತವಾಗಿ ನಿಷ್ಕ್ರಿಯ. ಕೆಳಗೆ ನಿಮ್ಮ ಆಯ್ಕೆಯನ್ನು ಯಾವಾಗ ಬೇಕಾದರೂ ಬದಲಾಯಿಸಬಹುದು.</p>

    <div class="mt-10 space-y-4" id="cookie-controls">
      <article class="arch-card flex flex-col gap-5 p-6 sm:flex-row sm:items-center sm:justify-between">
        <div><h2 class="text-lg font-extrabold">ಅಗತ್ಯ ಸಂಗ್ರಹಣೆ</h2><p class="mt-2 max-w-2xl text-sm leading-7 text-stone-ink/70">ತಾಣದ ಮೂಲ ಕಾರ್ಯ ಮತ್ತು ನಿಮ್ಮ ಕುಕಿ ಆಯ್ಕೆಯನ್ನು ನೆನಪಿಡಲು ಅಗತ್ಯ. ಇದನ್ನು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಲಾಗುವುದಿಲ್ಲ.</p></div>
        <span class="rounded-full bg-moss/10 px-4 py-2 text-sm font-bold text-moss">ಯಾವಾಗಲೂ ಸಕ್ರಿಯ</span>
      </article>

      <article class="arch-card flex flex-col gap-5 p-6 sm:flex-row sm:items-center sm:justify-between">
        <div><h2 class="text-lg font-extrabold">ವಿಶ್ಲೇಷಣಾ ಕುಕಿ · ಗೂಗಲ್ ಅನಾಲಿಟಿಕ್ಸ್</h2><p class="mt-2 max-w-2xl text-sm leading-7 text-stone-ink/70">ನೀವು ಹೇಗೆ ತಾಣವನ್ನು ಬಳಸುತ್ತೀರಿ ಎಂಬ ಒಟ್ಟಾರೆ, ಅಳತೆಗೊಳಿಸಿದ ಮಾಹಿತಿಯನ್ನು ತಿಳಿಯಲು ಸಹಾಯ. ಒಪ್ಪುವವರೆಗೆ ಜಿ-ಎಚ್‌ಎಕ್ಸ್‌ಎಂ22ಡಬ್ಲ್ಯೂಡಬ್ಲ್ಯುಪಿಕೆಪಿ ಸ್ಕ್ರಿಪ್ಟ್ ಲೋಡ್ ಆಗುವುದಿಲ್ಲ.</p></div>
        <label class="inline-flex cursor-pointer items-center gap-3 font-bold"><input id="analytics-consent" type="checkbox" class="h-5 w-5 accent-[#9c5d36]" /> ಸಕ್ರಿಯ</label>
      </article>

      <article class="arch-card flex flex-col gap-5 p-6 sm:flex-row sm:items-center sm:justify-between">
        <div><h2 class="text-lg font-extrabold">ಆದ್ಯತೆ ಸಂಗ್ರಹಣೆ</h2><p class="mt-2 max-w-2xl text-sm leading-7 text-stone-ink/70">ಈ ಐಚ್ಛಿಕ ಆಯ್ಕೆಯನ್ನು ಉಳಿಸಬಹುದು. ಭಾಷೆ ಪುಟದ URL ಅನ್ನು ಅನುಸರಿಸುತ್ತದೆ; ಭಾಷೆ ಅಥವಾ ಥೀಮ್ ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಮರುಸ್ಥಾಪಿಸಲಾಗುವುದಿಲ್ಲ.</p></div>
        <label class="inline-flex cursor-pointer items-center gap-3 font-bold"><input id="preference-consent" type="checkbox" class="h-5 w-5 accent-[#9c5d36]" /> ಸಕ್ರಿಯ</label>
      </article>

      <article class="arch-card flex flex-col gap-5 p-6 sm:flex-row sm:items-center sm:justify-between">
        <div><h2 class="text-lg font-extrabold">ಮಾರ್ಕೆಟಿಂಗ್ ಕುಕಿ</h2><p class="mt-2 max-w-2xl text-sm leading-7 text-stone-ink/70">ಈ ತಾಣವು ಪ್ರಸ್ತುತ ವೈಯಕ್ತಿಕೀಕೃತ ಜಾಹೀರಾತು ಅಥವಾ ಮಾರ್ಕೆಟಿಂಗ್ ಟ್ರ್ಯಾಕಿಂಗ್ ಬಳಸುವುದಿಲ್ಲ.</p></div>
        <span class="rounded-full bg-stone-ink/5 px-4 py-2 text-sm font-bold text-stone-ink/60">ನಿಷ್ಕ್ರಿಯ</span>
      </article>
    </div>

    <div class="mt-8 flex flex-wrap gap-3">
      <button id="save-consent" type="button" class="focus-ring rounded-full bg-fort px-6 py-3 font-extrabold text-white hover:bg-fort-deep">ಆಯ್ಕೆಗಳನ್ನು ಉಳಿಸಿ</button>
      <button id="reject-consent" type="button" class="focus-ring rounded-full border border-fort/35 bg-white/40 px-6 py-3 font-extrabold text-fort hover:bg-white">ಅಗತ್ಯವಲ್ಲದ ಎಲ್ಲವನ್ನು ನಿರಾಕರಿಸಿ</button>
    </div>
    <p id="consent-status" class="mt-4 min-h-7 text-sm font-bold text-moss" aria-live="polite"></p>

    <div class="policy mt-12">
      <h2>ಒಪ್ಪಿಗೆ ನಿರ್ವಹಣೆ</h2>
      <p>ನಿಮ್ಮ ಆಯ್ಕೆಯನ್ನು ಇದೇ ಬ್ರೌಸರ್‌ನ ಸ್ಥಳೀಯ ಸಂಗ್ರಹಣೆಯಲ್ಲಿ ಉಳಿಸಲಾಗುತ್ತದೆ. ಅದನ್ನು ಅಳಿಸಿದರೆ ಆಯ್ಕೆಯೂ ಮರುಹೊಂದಬಹುದು. ಕೆಲವು ಮೂರನೇ ಪಕ್ಷದ ಎಂಬೆಡ್ ಸೇವೆಗಳು, ವಿಶೇಷವಾಗಿ ಗೂಗಲ್ ನಕ್ಷೆ, ತಮ್ಮ ಕಾರ್ಯಾಚರಣೆಗೆ ಸ್ವಂತ ತಾಂತ್ರಿಕ ಸಂಗ್ರಹಣೆಯನ್ನು ಬಳಸಬಹುದು. ನಕ್ಷೆ ಬಳಕೆ ಗೂಗಲ್‌ನ ನೀತಿಗಳಿಗೆ ಒಳಪಟ್ಟಿರುತ್ತದೆ.</p>
      <p>ದೃಢವಾದ ಅನುಮತಿಯ ನಂತರ Google Analytics ತಕ್ಷಣ ಲೋಡ್ ಆಗಬಹುದು. ಹಿಂಪಡೆಯುವಿಕೆ ಈ ಪುಟದ ಮುಂದಿನ ಮಾಪನವನ್ನು ನಿಲ್ಲಿಸಿ ಲಭ್ಯ GA ಕುಕಿಗಳನ್ನು ಅಳಿಸಲು ಪ್ರಯತ್ನಿಸುತ್ತದೆ. ಹಿಂದಿನ ದತ್ತಾಂಶವನ್ನು ಮರಳಿ ಪಡೆಯಲಾಗುವುದಿಲ್ಲ. ಉಳಿಸುವಿಕೆ ವಿಫಲವಾದರೆ ಈ ಪುಟ ನಿಷ್ಕ್ರಿಯವಾಗಿರುತ್ತದೆ, ಆದರೆ ಬೇರೆ ಪುಟ ಅಥವಾ ಅವಧಿಯಲ್ಲಿ ಹಳೆಯ ಆಯ್ಕೆ ಇರಬಹುದು.</p>
    </div>
  </section>

  <script is:inline>
  (()=>{const analytics=document.getElementById('analytics-consent'),preference=document.getElementById('preference-consent'),status=document.getElementById('consent-status');const api=window.bengaluruAnalytics;if(!analytics||!preference||!status||!api)return;
  analytics.checked=api.get();try{preference.checked=JSON.parse(localStorage.getItem('bengaluru-fort-cookie-preferences')||'{}').preferences===true;}catch{}
  const save=allow=>{const result=api.set(allow,preference.checked);analytics.checked=result.effective;status.textContent=result.saved?"ನಿಮ್ಮ ಆಯ್ಕೆ ಉಳಿಸಲಾಗಿದೆ. ಅನುಮತಿಸಿದಾಗ ವಿಶ್ಲೇಷಣೆ ತಕ್ಷಣ ಲೋಡ್ ಆಗಬಹುದು; ಹಿಂಪಡೆಯುವಿಕೆ ಮುಂದಿನ ಮಾಪನವನ್ನು ನಿಲ್ಲಿಸುತ್ತದೆ, ಹಿಂದಿನ ದತ್ತಾಂಶವನ್ನು ಹಿಂಪಡೆಯುವುದಿಲ್ಲ.":(result.sharedOff?"ಈ ಪುಟದಲ್ಲಿ ವಿಶ್ಲೇಷಣೆ ನಿಷ್ಕ್ರಿಯವಾಗಿದೆ ಮತ್ತು ನಿರಾಕರಣೆ ದೃಢವಾಗಿದೆ. ಕೇಳಿದ ಆಯ್ಕೆಗಳು ಉಳಿಯಲಿಲ್ಲ.":"ಈ ಪುಟದಲ್ಲಿ ವಿಶ್ಲೇಷಣೆ ನಿಷ್ಕ್ರಿಯವಾಗಿದೆ. ಉಳಿಸುವಿಕೆ ವಿಫಲ; ಇನ್ನೊಂದು ಪುಟ ಅಥವಾ ಬ್ರೌಸರ್ ಅವಧಿಯಲ್ಲಿ ಹಳೆಯ ಆಯ್ಕೆ ಉಳಿದಿರಬಹುದು. ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ ಅಥವಾ ಈ ತಾಣದ ಸಂಗ್ರಹಿತ ಆಯ್ಕೆಯನ್ನು ಅಳಿಸಿ.");};
  document.getElementById('save-consent')?.addEventListener('click',()=>save(analytics.checked));document.getElementById('reject-consent')?.addEventListener('click',()=>{preference.checked=false;save(false);});})();
  </script>
</BaseLayout>

---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  lang?: 'kn-IN' | 'en-IN';
  alternatePath?: string;
  robots?: 'index,follow' | 'noindex,follow';
}
const {
  title,
  description,
  image = '/images/bengaluru-fort-courtyard.jpg',
  imageAlt,
  jsonLd,
  lang = 'kn-IN',
  alternatePath,
  robots = 'index,follow'
} = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL(image, Astro.site).href : image;
const isEnglish = lang === 'en-IN';
const metaImageAlt =
  imageAlt ??
  (isEnglish
    ? 'Bengaluru Fort (ಬೆಂಗಳೂರು ಕೋಟೆ) in Bengaluru, Karnataka, India'
    : 'ಬೆಂಗಳೂರು ಕೋಟೆ (Bengaluru Fort), ಬೆಂಗಳೂರು, ಕರ್ನಾಟಕ, ಭಾರತ');
const siteName = isEnglish ? 'Bengaluru Fort Visitor Guide' : 'ಬೆಂಗಳೂರು ಕೋಟೆ ಪ್ರವಾಸಿ ಮಾರ್ಗದರ್ಶಿ';
const alternateAbsolute = alternatePath && Astro.site ? new URL(alternatePath, Astro.site).href : alternatePath;
const currentLang = isEnglish ? 'en' : 'kn';
const alternateLang = isEnglish ? 'kn' : 'en';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#9c5d36" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots === 'noindex,follow' ? robots : 'index,follow,max-image-preview:large'} />
    <title>{title}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    {alternateAbsolute && <link rel="alternate" hreflang={alternateLang} href={alternateAbsolute} />}
    {canonical && <link rel="alternate" hreflang={currentLang} href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/icons/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/icons/favicon-16.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content={isEnglish ? 'Bengaluru Fort' : 'ಬೆಂಗಳೂರು ಕೋಟೆ'} />
    <meta property="og:locale" content={isEnglish ? 'en_IN' : 'kn_IN'} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={metaImageAlt} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline>
      (() => {
        const id = 'G-HXM22WWPKP';
        let loaded = false;
        const loadAnalytics = () => {
          if (loaded) return;
          loaded = true;
          const dataLayer = window['dataLayer'] = window['dataLayer'] || [];
          window['gtag'] = function(){ dataLayer.push(arguments); };
          window['gtag']('js', new Date());
          window['gtag']('config', id, { anonymize_ip: true });
          const analyticsScript = document.createElement('script');
          analyticsScript.async = true;
          analyticsScript.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(id);
          document.head.appendChild(analyticsScript);
        };
        try {
          const prefs = JSON.parse(localStorage.getItem('bengaluru-fort-cookie-preferences') || '{}');
          if (prefs.analytics === true) loadAnalytics();
          window.addEventListener('bengaluru-fort-consent-changed', (event) => {
            if (event.detail && event.detail.analytics === true) loadAnalytics();
          });
        } catch (_) {}
      })();
    </script>
    <script is:inline>
      if ('serviceWorker' in navigator && !location.hostname.includes('local' + 'host')) {
        window.addEventListener('load', function () {
          navigator.serviceWorker.register('/sw.js').catch(function () {});
        });
      }
    </script>
  </head>
  <body class="fort-texture min-h-screen">
    <Header lang={lang} />
    <main><slot /></main>
    <Footer lang={lang} />
  </body>
</html>
